# EditorConfig is awesome: https://EditorConfig.org

# top-most EditorConfig file
root = true

[*]
# Unix-style newlines with a newline ending every file
end_of_line = crlf
charset = utf-8
indent_style = space
indent_size = 4
trim_trailing_whitespace = true
insert_final_newline = true

[*.cs]
csharp_new_line_before_open_brace = all
csharp_indent_braces = false
csharp_indent_case_contents = true
csharp_indent_switch_labels = true
csharp_indent_labels = one_less_than_current
csharp_preferred_modifier_order = public,private,protected,internal,static,readonly,abstract,virtual,override,sealed,new,extern,unsafe
csharp_space_before_colon_in_inheritance_clause = true
csharp_space_between_method_declaration_parameter_list_parentheses = false
csharp_space_between_method_call_parameter_list_parentheses = false
csharp_space_between_parentheses = false
csharp_space_after_cast = false
csharp_space_before_comma = false
csharp_space_after_comma = true
csharp_space_before_dot = false
csharp_space_after_dot = false
csharp_space_around_equals_in_property_declaration = true
csharp_space_around_equals_in_method_declaration = true
csharp_space_around_equals_in_parameter_declaration = true
csharp_space_around_equals_in_local_declaration = true
csharp_space_before_open_square_brackets = false
csharp_space_between_empty_square_brackets = false
csharp_space_between_square_brackets = false
csharp_space_after_colon_in_case_label = true
csharp_space_after_colon_in_conditional = true
csharp_space_after_colon_in_default_value = true
csharp_space_after_keywords_in_control_flow_statements = true
csharp_space_before_semicolon = false
csharp_space_after_semicolon = true
csharp_space_around_binary_operators = true
csharp_space_around_unary_operators = false
csharp_space_inside_single_line_array_initializer_brackets = false
csharp_space_inside_single_line_method_call_parentheses = false
csharp_space_inside_single_line_method_declaration_parentheses = false
csharp_space_inside_single_line_property_initializer_brackets = false
csharp_new_line_before_else = true
csharp_new_line_before_catch = true
csharp_new_line_before_finally = true
csharp_new_line_before_members_in_object_initializers = true
csharp_new_line_before_members_in_anonymous_types = true
csharp_new_line_between_query_expression_clauses = true
csharp_indent_block_contents = true
csharp_indent_switch_case_blocks = true
csharp_indent_block = true
csharp_indent_array_initializer = true
csharp_indent_conditional_expression = true
csharp_indent_equals = true
csharp_indent_for_stmt = true
csharp_indent_foreach_stmt = true
csharp_indent_if_stmt = true
csharp_indent_label = true
csharp_indent_lock_stmt = true
csharp_indent_method_body = true
csharp_indent_namespace_body = true
csharp_indent_parameter = true
csharp_indent_property_body = true
csharp_indent_switch_stmt = true
csharp_indent_using_stmt = true
csharp_indent_while_stmt = true
csharp_preserve_single_line_statements = true
csharp_preserve_single_line_blocks = true
