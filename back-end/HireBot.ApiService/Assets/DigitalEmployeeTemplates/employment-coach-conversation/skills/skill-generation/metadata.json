{
  "name": "skill-generation",
  "display_name": "Skill Generation",
  "description": "Transforms workorders, conversation notes, uploads, and ready ontology projections into self-contained business skill packages under the current skills workspace.",
  "triggers": [
    "generate skill",
    "create skill",
    "skill package",
    "skill_workorder_summary",
    "SkillSpec"
  ],
  "capabilities": [
    {
      "id": "consume_employment_coach_workorder",
      "goal": "Consume employment-coach workorders and generate or update business skills.",
      "inputs": [
        "skill_name",
        "skill_description",
        "trigger",
        "expected_output",
        "generation_action",
        "workspace_root",
        "source"
      ],
      "outputs": [
        "skill_generation_progress",
        "skill_generation_done",
        "artifact groups by skill slug",
        "user_summary"
      ],
      "fallback": "A single skill item may fail without swallowing the successful results for other requested skills."
    },
    {
      "id": "render_and_validate_skill_package",
      "goal": "Render the core skill files, required consumer contracts, and validation report for a generated skill package.",
      "inputs": [
        "SkillSpec",
        "existing skills snapshot",
        "generated skill template",
        "projection contract template",
        "quality checklist"
      ],
      "outputs": [
        "todo_results",
        "technical_artifact",
        "user_summary",
        "references/quality-report.md",
        "contracts/projections/ontology_extraction/contract-index.json",
        "contracts/projections/ontology_extraction/<domain-slug>/<domain-slug>.domain-model.projection.json",
        "contracts/projections/ontology_extraction/<domain-slug>/<domain-slug>.json-schema.projection.json",
        "contracts/projections/ontology_extraction/<domain-slug>/<domain-slug>.prompt-constraint.projection.json",
        "contracts/projections/ontology_extraction/<domain-slug>/<domain-slug>.workflow-contract.projection.json"
      ],
      "fallback": "If rendering or validation fails, keep prior files unchanged and return a readable failure summary."
    }
  ],
  "boundaries": [
    "Write only inside skills/<skill_slug>/.",
    "Do not modify config/, ontology/, or external/.",
    "Do not write plaintext credentials.",
    "Do not register skill-generation itself as a projection consumer."
  ],
  "source": "conversation|upload|workorder",
  "version": "2.1.0",
  "quality_gates": {
    "required_fields": [
      "name",
      "description",
      "capabilities"
    ],
    "minimum_triggers": 1,
    "capability_required_fields": [
      "inputs",
      "outputs",
      "fallback"
    ],
    "secret_policy": "reject_or_redact_before_write",
    "projection_contract_policy": "required_bound_projection_contract_warning_on_open_questions_block_on_missing_invalid_unwritable_or_slug_mismatch"
  }
}
