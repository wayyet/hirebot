{
  "schemaVersion": 1,
  "stages": [
    {
      "name": "stage1_material",
      "label": "Stage 1: Material Collection",
      "ownerSkill": "employment-coach-conversation",
      "artifacts": [
        {
          "type": "material_collection_progress",
          "label": "Material Collection Progress",
          "display": "progress",
          "terminal": false
        },
        {
          "type": "material_handoff_summary",
          "label": "Material Handoff Summary",
          "display": "tree",
          "terminal": true
        }
      ]
    },
    {
      "name": "stage2_skill",
      "label": "Stage 2: Skill Definition And Generation",
      "ownerSkill": "employment-coach-conversation",
      "gate": {
        "requiresStage": "stage1_material"
      },
      "artifacts": [
        {
          "type": "skill_workorder_progress",
          "label": "Skill Workorder Progress",
          "display": "progress",
          "terminal": false
        },
        {
          "type": "skill_definition_ready",
          "label": "Await Skill Definition Approval",
          "display": "badge",
          "terminal": false,
          "note": "Confirmation gate for the skill definition draft. User approval is required before emitting skill_workorder_summary."
        },
        {
          "type": "skill_workorder_summary",
          "label": "Skill Workorder Summary",
          "display": "tree",
          "terminal": true,
          "note": "data must include workspace_root, template_slug, and the projection-pass fields on items[]. Missing workspace_root or template_slug blocks this terminal artifact."
        },
        {
          "type": "ontology_projection_ready",
          "label": "Await Business Information Preparation Approval",
          "display": "badge",
          "terminal": false,
          "note": "Confirmation gate after skill_workorder_summary. User approval is required before triggering ontology projection pass."
        },
        {
          "type": "skill_generation_ready",
          "label": "Await Skill Generation Approval",
          "display": "badge",
          "terminal": false,
          "note": "Confirmation gate after consumable ontology_projection_done. User approval is required before triggering skill-generation."
        },
        {
          "type": "skill_projection_binding_ready",
          "label": "业务资料已准备好，正在生成技能实现",
          "display": "badge",
          "terminal": false,
          "note": "Optional progress notification only. Emit only when ontology projection produced consumable producer projections. It must not replace the skill_generation_ready confirmation gate."
        }
      ]
    },
    {
      "name": "stage3_external",
      "label": "Stage 3: External Capabilities",
      "ownerSkill": "employment-coach-conversation",
      "gate": {
        "requiresStage": "stage2_skill"
      },
      "artifacts": [
        {
          "type": "external_workorder_progress",
          "label": "External Capability Progress",
          "display": "progress",
          "terminal": false
        },
        {
          "type": "external_workorder_summary",
          "label": "External Capability Summary",
          "display": "tree",
          "terminal": true,
          "note": "This closes external requirements only. It does not mean the side panel save has completed."
        },
        {
          "type": "external_config_committed",
          "label": "External Config Committed",
          "display": "tree",
          "terminal": true,
          "note": "Emitted by the system layer after the side panel save or skip succeeds."
        }
      ]
    },
    {
      "name": "stage4_packaging",
      "label": "Stage 4: Packaging",
      "ownerSkill": "employment-coach-conversation",
      "gate": {
        "requiresStage": "stage3_external"
      },
      "artifacts": [
        {
          "type": "packaging_testcases_ready",
          "label": "Await Test Case Generation Approval",
          "display": "badge",
          "terminal": false,
          "note": "Optional enhancement gate after external config save or skip. User skip must not block packaging."
        },
        {
          "type": "packaging_testcases_progress",
          "label": "Packaging Test Cases In Progress",
          "display": "progress",
          "terminal": false
        },
        {
          "type": "packaging_testcases_done",
          "label": "Packaging Test Cases Done",
          "display": "tree",
          "terminal": true
        },
        {
          "type": "review_readiness",
          "label": "Package Completeness Review Ready",
          "display": "badge",
          "terminal": false,
          "note": "Optional pre-packaging review gate backed by digital-employee-package-completeness-review. User skip must not block packaging."
        },
        {
          "type": "review_progress",
          "label": "Package Completeness Review In Progress",
          "display": "progress",
          "terminal": false,
          "note": "Emitted when the optional package completeness review is running."
        },
        {
          "type": "review_report",
          "label": "Package Completeness Review Report",
          "display": "tree",
          "terminal": true,
          "note": "Review result summary from digital-employee-package-completeness-review. It informs the user but does not remove packaging authority."
        },
        {
          "type": "packaging_progress",
          "label": "Packaging In Progress",
          "display": "progress",
          "terminal": false
        },
        {
          "type": "template_package",
          "label": "Template Package Ready",
          "kind": "file",
          "display": "file",
          "terminal": true,
          "note": "kind must be file. fileUrl must be the real download URL returned by the sandbox gateway."
        }
      ]
    }
  ],
  "packaging_stage": {
    "name": "stage4_packaging",
    "label": "Stage 4: Packaging",
    "ownerSkill": "employment-coach-conversation",
    "gate": {
      "anyOf": [
        {
          "kind": "downstream_terminal",
          "requiresDownstream": [
            "ontology-slice-extraction",
            "skill-generation"
          ]
        },
        {
          "kind": "user_explicit_request",
          "requiresCoachSummaries": [
            "material_handoff_summary",
            "skill_workorder_summary",
            "external_workorder_summary"
          ],
          "userIntentKeywords": [
            "generate package",
            "package",
            "export",
            "zip"
          ]
        }
      ]
    },
    "description": "Enter packaging when downstream terminal artifacts are ready, or when all coach summaries exist and the user explicitly asks to package. packaging-test-cases and testcases/evaluation-test-cases.json are optional enhancements and must never block packaging.",
    "artifacts": [
      {
        "type": "packaging_testcases_ready",
        "label": "Await Test Case Generation Approval",
        "display": "badge",
        "terminal": false
      },
      {
        "type": "packaging_testcases_progress",
        "label": "Packaging Test Cases In Progress",
        "display": "progress",
        "terminal": false
      },
      {
        "type": "packaging_testcases_done",
        "label": "Packaging Test Cases Done",
        "display": "tree",
        "terminal": true
      },
      {
        "type": "review_readiness",
        "label": "Package Completeness Review Ready",
        "display": "badge",
        "terminal": false
      },
      {
        "type": "review_progress",
        "label": "Package Completeness Review In Progress",
        "display": "progress",
        "terminal": false
      },
      {
        "type": "review_report",
        "label": "Package Completeness Review Report",
        "display": "tree",
        "terminal": true
      },
      {
        "type": "packaging_progress",
        "label": "Packaging In Progress",
        "display": "progress",
        "terminal": false
      },
      {
        "type": "template_package",
        "label": "Template Package Ready",
        "kind": "file",
        "display": "file",
        "terminal": true,
        "note": "kind must be file. fileUrl must be the real download URL returned by the sandbox gateway."
      }
    ]
  },
  "downstream_artifacts": {
    "description": "Artifacts emitted by downstream skills and the upstream coach. The frontend routes them to dedicated execution tracks and must not let them override the main stage semantics.",
    "artifacts": [
      {
        "type": "skill_definition_ready",
        "ownerSkill": "employment-coach-conversation",
        "label": "Await Skill Definition Approval",
        "display": "badge",
        "terminal": false
      },
      {
        "type": "ontology_projection_ready",
        "ownerSkill": "employment-coach-conversation",
        "label": "Await Business Information Preparation Approval",
        "display": "badge",
        "terminal": false
      },
      {
        "type": "skill_generation_ready",
        "ownerSkill": "employment-coach-conversation",
        "label": "Await Skill Generation Approval",
        "display": "badge",
        "terminal": false
      },
      {
        "type": "skill_projection_binding_ready",
        "ownerSkill": "employment-coach-conversation",
        "label": "业务资料已准备好，正在生成技能实现",
        "display": "badge",
        "terminal": false,
        "note": "Optional progress notification only; not a confirmation gate."
      },
      {
        "type": "external_config_committed",
        "ownerSkill": "external-config",
        "label": "External Config Committed",
        "display": "tree",
        "terminal": true
      },
      {
        "type": "packaging_testcases_ready",
        "ownerSkill": "employment-coach-conversation",
        "label": "Await Test Case Generation Approval",
        "display": "badge",
        "terminal": false
      },
      {
        "type": "packaging_testcases_progress",
        "ownerSkill": "packaging-test-cases",
        "label": "Packaging Test Cases In Progress",
        "display": "progress",
        "terminal": false
      },
      {
        "type": "packaging_testcases_done",
        "ownerSkill": "packaging-test-cases",
        "label": "Packaging Test Cases Done",
        "display": "tree",
        "terminal": true
      },
      {
        "type": "review_readiness",
        "ownerSkill": "employment-coach-conversation",
        "label": "Package Completeness Review Ready",
        "display": "badge",
        "terminal": false
      },
      {
        "type": "review_progress",
        "ownerSkill": "employment-coach-conversation",
        "label": "Package Completeness Review In Progress",
        "display": "progress",
        "terminal": false
      },
      {
        "type": "review_report",
        "ownerSkill": "employment-coach-conversation",
        "label": "Package Completeness Review Report",
        "display": "tree",
        "terminal": true
      },
      {
        "type": "ontology_slice_extraction_progress",
        "ownerSkill": "ontology-slice-extraction",
        "label": "Ontology Slice Extraction Progress",
        "display": "progress",
        "terminal": false
      },
      {
        "type": "ontology_slice_extraction_done",
        "ownerSkill": "ontology-slice-extraction",
        "label": "Ontology Slice Extraction Done",
        "display": "tree",
        "terminal": true
      },
      {
        "type": "ontology_projection_progress",
        "ownerSkill": "ontology-projection",
        "label": "技能准备进度",
        "display": "progress",
        "terminal": false
      },
      {
        "type": "ontology_projection_done",
        "ownerSkill": "ontology-projection",
        "label": "技能准备结果",
        "display": "tree",
        "terminal": true
      },
      {
        "type": "skill_generation_progress",
        "ownerSkill": "skill-generation",
        "label": "Skill Generation Progress",
        "display": "progress",
        "terminal": false
      },
      {
        "type": "skill_generation_done",
        "ownerSkill": "skill-generation",
        "label": "Skill Generation Done",
        "display": "tree",
        "terminal": true
      }
    ]
  }
}
