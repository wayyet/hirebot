  "default_selection_policy": {
    "prefer_ready_only": true,
    "block_on_open_questions": true,
    "fallback_order_by_target_view": [
      "workflow-contract",
      "prompt-constraint",
      "domain-model",
      "metric-catalog"
    ],
    "multi_view_resolution_hints": [
      "Prefer the target view that matches the user's explicitly requested evaluation artifact.",
      "If the request mixes evaluation flow and scoring policy, choose workflow-contract only when step ordering, gating conditions, or red-line checkpoints are the core deliverable.",
      "If the request asks for scoring criteria, dimension policy, or judgement language, choose prompt-constraint.",
      "If the request asks for the evaluation domain model itself (employee templates, metric entities), choose domain-model.",
      "If the request asks for the metric catalog (named scoring dimensions with weights and thresholds), choose metric-catalog."
    ]
  },
