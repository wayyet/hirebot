  "selection_algorithm": {
    "version": "1.0",
    "goal": "Select the safest READY topic and target view by accumulating deterministic scores from request signals instead of relying on ad hoc pairwise branching.",
    "inputs": [
      "user_request_text",
      "topic_scoring",
      "target_view_scoring",
      "topics",
      "default_selection_policy"
    ],
    "normalization_steps": [
      "Lowercase the request text before matching signals.",
      "Treat exact phrase hits as a single match per signal per topic or view.",
      "Do not count the same signal twice within the same scoring bucket."
    ],
    "phases": [
      {
        "phase": "score_topics",
        "steps": [
          {
            "action": "initialize_topic_scores",
            "description": "Create one score record per topic with score = 0 and an empty matched_reasons list."
          },
          {
            "action": "apply_primary_intent_match",
            "source": "topic_scoring.topics[].primary_intent_signals",
            "score_dimension": "primary_intent_match",
            "match_mode": "best_topic_only",
            "description": "Award the primary intent score to the topic whose primary intent signals best match the user's main requested deliverable."
          },
          {
            "action": "apply_explicit_artifact_bonus",
            "source": "topic_scoring.topics[].explicit_artifact_signals",
            "score_dimension": "explicit_artifact_bonus",
            "match_mode": "all_matching_topics",
            "description": "Award the explicit artifact bonus when the request explicitly names an artifact strongly associated with a topic."
          },
          {
            "action": "apply_strong_keyword_matches",
            "source": "topic_scoring.topics[].primary_intent_signals",
            "score_dimension": "strong_keyword_match",
            "match_mode": "per_signal",
            "description": "For each matched strong signal, add the strong keyword score once per unique signal."
          },
          {
            "action": "apply_supporting_keyword_matches",
            "source": "topic_scoring.topics[].supporting_signals",
            "score_dimension": "supporting_keyword_match",
            "match_mode": "per_signal",
            "description": "For each matched supporting signal, add the supporting keyword score once per unique signal."
          },
          {
            "action": "apply_cross_topic_penalties",
            "source": "topic_scoring.topics[].demote_when_competing_topic_signals",
            "score_dimension": "cross_topic_conflict_penalty",
            "match_mode": "per_topic_if_competing_topic_is_stronger",
            "description": "Subtract the cross-topic penalty when the request contains stronger competing-topic signals and the current topic is only a secondary fit."
          },
          {
            "action": "prefer_ready_topics_only",
            "description": "If default_selection_policy.prefer_ready_only is true, remove non-READY topics that have no READY views from final selection consideration."
          },
          {
            "action": "rank_topics",
            "description": "Sort topic score records by descending score and keep the top candidate list."
          },
          {
            "action": "clarify_on_close_topic_scores",
            "threshold_source": "topic_scoring.clarify_when_score_gap_below",
            "description": "If the score gap between the top two candidate topics is below the threshold, return clarify instead of auto-selecting a topic."
          }
        ],
        "output": "selected_topic or clarify"
      },
      {
        "phase": "score_target_views",
        "precondition": "selected_topic exists",
        "steps": [
          {
            "action": "initialize_view_scores",
            "description": "Create one score record per READY target view under the selected topic with score = 0 and an empty matched_reasons list."
          },
          {
            "action": "apply_explicit_output_matches",
            "source": "target_view_scoring.views[].explicit_output_signals",
            "score_dimension": "explicit_output_match",
            "match_mode": "all_matching_views",
            "description": "Award explicit output match when the request names a concrete artifact such as workflow contract, prompt policy, domain model, or metric catalog."
          },
          {
            "action": "apply_strong_view_signal_matches",
            "source": "target_view_scoring.views[].strong_signals",
            "score_dimension": "strong_signal_match",
            "match_mode": "per_signal",
            "description": "For each matched strong target-view signal, add the strong signal score once per unique signal."
          },
          {
            "action": "apply_supporting_view_signal_matches",
            "source": "target_view_scoring.views[].supporting_signals",
            "score_dimension": "supporting_signal_match",
            "match_mode": "per_signal",
            "description": "For each matched supporting signal, add the supporting signal score once per unique signal."
          },
          {
            "action": "apply_topic_overrides",
            "source": "target_view_scoring.within_topic_overrides",
            "match_mode": "selected_topic_only",
            "description": "Apply within-topic bonuses for the selected topic when the request contains the override's request signals."
          },
          {
            "action": "apply_default_view_bonus",
            "source": "topics[].default_target_view",
            "score_dimension": "topic_default_view_bonus",
            "match_mode": "selected_topic_default_view_only_when_no_stronger_explicit_match",
            "description": "Award the default target view bonus only as a weak fallback when the request does not strongly point to another target view."
          },
          {
            "action": "apply_cross_view_penalties",
            "source": "target_view_scoring.views[].demote_when_competing_view_signals",
            "score_dimension": "cross_view_conflict_penalty",
            "match_mode": "per_view_if_competing_view_is_stronger",
            "description": "Subtract the cross-view penalty when another target view has the stronger artifact match and the current view is only secondary."
          },
          {
            "action": "rank_target_views",
            "description": "Sort view score records by descending score and keep the top candidate list."
          },
          {
            "action": "clarify_on_close_view_scores",
            "threshold_source": "target_view_scoring.clarify_when_score_gap_below",
            "description": "If the score gap between the top two target views is below the threshold, return clarify instead of auto-selecting a target view."
          }
        ],
        "output": "selected_target_view or clarify"
      },
      {
        "phase": "resolve_projection",
        "precondition": "selected_topic and selected_target_view exist",
        "steps": [
          {
            "action": "lookup_projection_record",
            "source": "topics[].views[]",
            "description": "Find the projection record whose topic and target_view match the selected values."
          },
          {
            "action": "enforce_ready_status",
            "description": "Use the projection only when its status is READY; otherwise fall back to the topic default target view only if that still matches the requested outcome."
          },
          {
            "action": "block_on_open_questions_when_required",
            "description": "If default_selection_policy.block_on_open_questions is true and the selected projection carries blocking open questions, surface the block instead of silently proceeding."
          }
        ],
        "output": "selected_projection_path or clarify_or_block"
      }
    ],
    "result_shape": {
      "topic_scores": "array",
      "selected_topic": "string or null",
      "target_view_scores": "array",
      "selected_target_view": "string or null",
      "resolution": "selected | clarify | block",
      "projection_path": "string or null"
    }
  },
