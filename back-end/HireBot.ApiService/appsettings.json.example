{
    "ConnectionStrings": {
        "DefaultConnection": "Host=localhost;Port=5432;Database=HireBot;Username=postgres;Password=<YOUR_DB_PASSWORD>;"
    },
    "Database": {
        "AutoMigrateOnStartup": true
    },
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning"
        }
    },
    "HireBot": {
        "DataRoot": "ncrew-hire-data",
        "EvaluationResourceRoot": "resources",
        "DigitalEmployeeTemplatesRoot": "Assets/DigitalEmployeeTemplates",
        "InstanceFixturesRoot": "instance-fixtures",
        "DiscoveryRoleTemplatePath": "Assets/DigitalEmployeeTemplates/employment-coach-conversation",
        "MaxActivePersonalClonesPerOwner": 10,
        "DigitalWorkforceRoot": "digital-workforce",
        "PersonalCloneArtifactsRoot": "personal-clone-artifacts"
    },
    "Storage": {
        "Provider": "TencentCos",
        "ProjectRoot": "goodcrew-hire",
        "TencentCos": {
            "AppId": "<YOUR_TENCENT_COS_APP_ID>",
            "SecretId": "<YOUR_TENCENT_COS_SECRET_ID>",
            "SecretKey": "<YOUR_TENCENT_COS_SECRET_KEY>",
            "Region": "ap-guangzhou",
            "BucketName": "goodcrew-hire",
            "KeyDurationSecond": 600,
            "Endpoint": ""
        }
    },
    "KingCrab": {
        "BaseUrl": "http://localhost:18789/",
        "BearerToken": "",
        "HttpTimeoutSeconds": 120,
        "HireBotApiPrefix": "/api/integration/hirebot"
    },
    "AllowedOrigins": [
        "http://localhost:5173",
        "http://127.0.0.1:5173",
        "http://localhost:3000"
    ],
    "OpenSandbox": {
        "Domain": "127.0.0.1:8080",
        "Protocol": "Http",
        "UseServerProxy": true,
        "Image": "ai4c-tcr.tencentcloudcr.com/agentfoundry/king-crab:opensandbox-<TAG>",
        "Resource": {
            "cpu": "500m",
            "memory": "500Mi"
        },
        "TimeoutSeconds": 43200,
        "ReadyTimeoutSeconds": 180,
        "RequestTimeoutSeconds": 600,
        "GatewayPort": 18789,
        "Entrypoint": [
            "/app/OpenClaw.Gateway"
        ],
        "DefaultTimeoutSecondsByRole": {
            "hiring": 7200,
            "evaluation-target": 7200,
            "evaluation-evaluator": 7200
        },
        "KingCrab": {
            "AuthToken": "<YOUR_OPENSANDBOX_AUTH_TOKEN>",
            "OidcAuthority": "https://passport.example.com/realms/<REALM>",
            "OidcAudience": "account",
            "ToolTimeoutSeconds": 600,
            "NetworkEgressAllowHosts": [],
            "ClientId": "ncrew-builder-sandbox",
            "ClientSecret": "<YOUR_OPENSANDBOX_CLIENT_SECRET>",
            "LlmProvider": "deepseek",
            "LlmModel": "deepseek-v4-pro",
            "LlmEndpoint": "https://<LLM_GATEWAY>/v1",
            "LlmApiKey": "<YOUR_LLM_API_KEY>",
            "LlmTemperature": 1.0,
            "LlmEnableThinking": true
        },
        "McpConfig": {
            "Enabled": false,
            "Servers": {}
        }
    },
    "SandboxPvc": {
        "Enabled": false,
        "Namespace": "opensandbox",
        "StorageClassName": "",
        "WorkspaceSize": "5Gi",
        "MemorySize": "5Gi",
        "AccessMode": "ReadWriteMany",
        "KubeConfigPath": ""
    },
    "BuildService": {
        "BaseUrl": "https://goodcrew-builder.example.com/",
        "ApiPrefix": "/api/store",
        "BearerToken": "",
        "HttpTimeoutSeconds": 60
    },
    "Security": {
        "OidcAuthority": "https://passport.example.com/realms/<REALM>",
        "OidcAudience": "",
        "OidcClientId": "<YOUR_OIDC_CLIENT_ID>",
        "OidcRequireHttpsMetadata": true
    },
    "ConsoleAuth": {
        "Authority": "https://passport.example.com",
        "Realm": "<REALM>",
        "ClientId": "<YOUR_OIDC_CLIENT_ID>",
        "Scope": "openid profile email organization",
        "BypassAuth": false,
        "TemplateApiBase": ""
    },
    "ConsoleUi": {
        "EnableWarmTheme": false
    },
    "Evaluation": {
        "ApiBaseUrl": "http://localhost:5000",
        "GatewayUseTls": false
    },
    "AllowedHosts": "*"
}
