<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <Content Update="Assets\SystemSkills\README.md">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.7" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.7" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.7">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.OpenApi" Version="2.4.1" />
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.Async" Version="2.1.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.1.7" />
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="1.2.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\HireBot.Core\HireBot.Core.csproj" />
    <ProjectReference Include="..\..\HireBot.ServiceDefaults\HireBot.ServiceDefaults.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- 排除运行时数据目录，避免超长路径触发 MSB3030 -->
    <Content Remove="ncrew-hire-data\**" />
    <None Remove="ncrew-hire-data\**" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="appsettings.Development.local.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- .json 已被 Web SDK 默认收录，用 Update 补充发布配置；避免 NETSDK1022 重复错误 -->
    <Content Update="Assets\**\*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <!-- 其余类型 Web SDK 不默认收录，用 Include 显式添加（.md/.py/.txt/.ps1/.zip/.7z 等） -->
    <Content Include="Assets\**\*.md;Assets\**\*.py;Assets\**\*.txt;Assets\**\*.ps1;Assets\**\*.zip;Assets\**\*.7z">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

</Project>
