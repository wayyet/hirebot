{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openclaw.local/skills/ontology-extraction/templates/DISPATCH_CALLBACK.schema.json",
  "title": "Ontology Extraction Dispatch Callback",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "dispatch_callback"
  ],
  "properties": {
    "dispatch_callback": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_dispatch_target",
        "handoff_ids",
        "user_summary",
        "technical_artifact",
        "artifacts",
        "todo_results",
        "status",
        "errors"
      ],
      "properties": {
        "source_dispatch_target": {
          "type": "string",
          "const": "ontology-extraction"
        },
        "handoff_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/nonEmptyString" }
        },
        "user_summary": { "$ref": "#/$defs/nonEmptyString" },
        "technical_artifact": { "$ref": "#/$defs/technicalArtifact" },
        "artifacts": {
          "type": "array",
          "items": { "$ref": "#/$defs/artifact" }
        },
        "todo_results": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/todoResult" }
        },
        "status": {
          "type": "string",
          "enum": ["success", "partial", "failed"]
        },
        "errors": {
          "type": "array",
          "items": { "$ref": "#/$defs/nonEmptyString" }
        }
      }
    }
  },
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "technicalArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ontology_dir", "extraction_summary", "validation"],
      "properties": {
        "ontology_dir": { "$ref": "#/$defs/nonEmptyString" },
        "extraction_summary": { "$ref": "#/$defs/nonEmptyString" },
        "validation": {
          "type": "string",
          "enum": ["PASS", "WARNING", "FAIL"]
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "kind"],
      "properties": {
        "path": { "$ref": "#/$defs/nonEmptyString" },
        "kind": {
          "type": "string",
          "enum": ["ontology_slice_json", "ontology_slice_markdown", "other"]
        }
      }
    },
    "todoResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["handoff_id", "status", "validation", "artifacts", "extraction_summary", "errors"],
      "properties": {
        "handoff_id": { "$ref": "#/$defs/nonEmptyString" },
        "status": {
          "type": "string",
          "enum": ["success", "warning", "failed", "skipped"]
        },
        "validation": {
          "type": "string",
          "enum": ["PASS", "WARNING", "FAIL"]
        },
        "artifacts": {
          "type": "array",
          "items": { "$ref": "#/$defs/artifact" }
        },
        "extraction_summary": { "$ref": "#/$defs/nonEmptyString" },
        "errors": {
          "type": "array",
          "items": { "$ref": "#/$defs/nonEmptyString" }
        }
      }
    }
  }
}
