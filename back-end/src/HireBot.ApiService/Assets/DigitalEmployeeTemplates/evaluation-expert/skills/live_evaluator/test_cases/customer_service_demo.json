{
  "description": "电商客服专员评估测试用例 — Demo",
  "role": "customer_service",
  "industry": "ecommerce",
  "test_cases": [
    {
      "test_case_id": "TC-001",
      "scenario_name": "商品质量问题退货申请",
      "input": {
        "user_request": "你好，我上周买的商品收到后发现质量有问题，外包装破损，里面的东西也坏了，我要申请退货退款！",
        "context": {
          "order_id": "ORD-20260415-88888",
          "product_name": "某某电子产品",
          "purchase_date": "2026-04-15"
        }
      },
      "expected_behavior_sequence": [
        {"step": 1, "action": "安抚用户情绪", "criteria": "语气友好，表达同理心"},
        {"step": 2, "action": "收集订单信息", "criteria": "询问或查询订单号、商品信息"},
        {"step": 3, "action": "判断退货条件", "criteria": "根据退货政策判断是否符合"},
        {"step": 4, "action": "处理退货申请", "criteria": "告知处理结果和后续流程"},
        {"step": 5, "action": "登记工单", "criteria": "创建退货工单，记录处理结果"},
        {"step": 6, "action": "闭环确认", "criteria": "告知用户后续流程，确认满意度"}
      ],
      "expected_output": {
        "resolution": "退货申请已受理",
        "user_satisfaction": "用户满意",
        "artifacts_created": ["退货工单"]
      }
    },
    {
      "test_case_id": "TC-002",
      "scenario_name": "物流延误投诉",
      "input": {
        "user_request": "我的订单已经下单5天了，物流一直显示在途，什么时候能到？我很着急！",
        "context": {
          "order_id": "ORD-20260418-12345",
          "product_name": "日用品",
          "purchase_date": "2026-04-18"
        }
      },
      "expected_behavior_sequence": [
        {"step": 1, "action": "安抚用户情绪", "criteria": "理解用户焦虑，表达关心"},
        {"step": 2, "action": "查询物流状态", "criteria": "调用物流查询工具获取最新状态"},
        {"step": 3, "action": "告知物流情况", "criteria": "清晰说明当前物流状态和预计到达时间"},
        {"step": 4, "action": "提供解决方案", "criteria": "如有异常，提供催件或补偿方案"},
        {"step": 5, "action": "登记跟进工单", "criteria": "记录用户投诉，设置跟进提醒"}
      ],
      "expected_output": {
        "resolution": "物流情况已告知，异常已处理",
        "user_satisfaction": "用户基本满意",
        "artifacts_created": ["跟进工单"]
      }
    },
    {
      "test_case_id": "TC-003",
      "scenario_name": "查询今日金价",
      "input": {
        "user_request": "查询今日金价",
        "context": {
          "order_id": "ORD-20260418-12345",
          "product_name": "金价",
          "purchase_date": "2026-04-18"
        }
      },
      "expected_behavior_sequence": [
        {"step": 1, "action": "进行网络搜索", "criteria": "网络搜索,官方权威网站"},
        {"step": 2, "action": "整合网络搜索结果", "criteria": "整合信息，避免信息不全"},
        {"step": 3, "action": "回复用户", "criteria": "信息完整，清晰。实际解决了用户今日金价的问题"}

      ],
      "expected_output": {
        "resolution": "明确告诉用户今日金价",
        "user_satisfaction": "用户基本满意",
        "artifacts_created": ["网络搜索"]
      }
    }
  ]
}
