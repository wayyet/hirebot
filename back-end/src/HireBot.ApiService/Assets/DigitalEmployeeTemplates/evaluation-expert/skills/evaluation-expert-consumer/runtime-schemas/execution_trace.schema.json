{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://openclaw.io/evaluation-expert-consumer/runtime-schemas/execution_trace.schema.json",
  "title": "ExecutionTrace",
  "description": "STEP 3 (driveEmployeeOnScenario) per-scenario observation log. The evaluator drives the evaluatee through one test case and records every observable signal. This trace is the sole runtime evidence STEP 4 fan-out is allowed to cite.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "evaluation_id",
    "test_case_id",
    "started_at",
    "ended_at",
    "dialog_turns",
    "actual_tool_calls",
    "termination"
  ],
  "properties": {
    "evaluation_id": { "type": "string", "minLength": 1 },
    "test_case_id": { "type": "string", "minLength": 1 },
    "started_at": { "type": "string", "format": "date-time" },
    "ended_at": { "type": "string", "format": "date-time" },
    "dialog_turns": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["turn_index", "actor", "content"],
        "properties": {
          "turn_index": { "type": "integer", "minimum": 0 },
          "actor": {
            "type": "string",
            "enum": ["evaluator", "evaluatee"]
          },
          "content": { "type": "string" },
          "timestamp": { "type": "string", "format": "date-time" },
          "latency_ms": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "actual_tool_calls": {
      "type": "array",
      "description": "Tool calls actually performed by the evaluatee, in execution order.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["tool_name", "called_at", "outcome"],
        "properties": {
          "tool_name": { "type": "string", "minLength": 1 },
          "called_at": { "type": "string", "format": "date-time" },
          "arguments": {
            "type": "object",
            "additionalProperties": true
          },
          "outcome": {
            "type": "string",
            "enum": ["success", "error", "timeout", "rejected"]
          },
          "error_message": { "type": "string" },
          "after_turn_index": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "actual_artifacts": {
      "type": "array",
      "description": "Artifacts produced (tickets, records, refunds). Mirrors test_case.expected_output.expected_outcomes for comparison.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["artifact_type"],
        "properties": {
          "artifact_type": { "type": "string", "minLength": 1 },
          "artifact_id": { "type": "string" },
          "fields": {
            "type": "object",
            "additionalProperties": true
          },
          "created_at": { "type": "string", "format": "date-time" }
        }
      }
    },
    "simulator_trail": {
      "type": "array",
      "description": "Per-turn record of SimulatorDecision objects emitted by the user simulator. Append-only; one entry per customer turn (turn_index = 0 for opening_message, turn_index = 1 for the customer's first reaction to the evaluatee, etc.). Used by STEP 8 ScenarioReport for narrative attribution (emotion arc, perceived_progress trajectory, why the conversation ended). Empty array is allowed only for legacy scripted runs that did not use a simulator.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "turn_index",
          "should_continue",
          "internal_emotion",
          "perceived_progress"
        ],
        "properties": {
          "turn_index": { "type": "integer", "minimum": 0 },
          "should_continue": { "type": "boolean" },
          "stop_reason": {
            "type": ["string", "null"],
            "enum": [
              null,
              "goal_achieved",
              "bottom_line_violated",
              "deadlock_detected",
              "customer_gave_up"
            ]
          },
          "next_utterance": { "type": "string" },
          "internal_emotion": {
            "type": "string",
            "enum": [
              "angry",
              "anxious",
              "neutral",
              "curious",
              "satisfied",
              "skeptical",
              "frustrated",
              "calmer",
              "more_upset"
            ]
          },
          "perceived_progress": {
            "type": "string",
            "enum": ["none", "partial", "resolved", "regressed"]
          },
          "rationale": { "type": "string" },
          "violated_bottom_line": { "type": "boolean", "default": false },
          "decided_at": { "type": "string", "format": "date-time" }
        }
      }
    },
    "termination": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reason"],
      "properties": {
        "reason": {
          "type": "string",
          "enum": [
            "completed_normally",
            "evaluator_ended",
            "max_turns_reached",
            "deadlock_detected",
            "bottom_line_violated",
            "evaluatee_error",
            "tool_failure",
            "timeout"
          ]
        },
        "detail": { "type": "string" },
        "final_emotion": {
          "type": "string",
          "enum": [
            "angry",
            "anxious",
            "neutral",
            "curious",
            "satisfied",
            "skeptical",
            "frustrated"
          ],
          "description": "Customer's emotional state when the conversation ended. Sourced from the last simulator_trail entry's internal_emotion (mapped from delta to absolute if needed)."
        },
        "turns_used": {
          "type": "integer",
          "minimum": 0,
          "description": "Number of customer turns actually used. Compared against turn_budget.hard_max_turns for max_turns_reached classification."
        }
      }
    }
  }
}
