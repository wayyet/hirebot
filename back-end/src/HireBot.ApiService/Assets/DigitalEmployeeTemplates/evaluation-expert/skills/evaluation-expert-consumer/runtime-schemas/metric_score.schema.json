{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://openclaw.io/evaluation-expert-consumer/runtime-schemas/metric_score.schema.json",
  "title": "MetricScore",
  "description": "Output of a single STEP 4 fan-out call: one (test_case, metric) pair scored by exactly one LLM invocation. The schema is enforced via response_format on the LLM call, and the result is rejected if it contains red_line_passed (red-line judgement is deterministic and lives in STEP 7, not here).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "evaluation_id",
    "test_case_id",
    "metric_code",
    "metric_version",
    "score",
    "reasoning",
    "evidence",
    "observed_signals"
  ],
  "properties": {
    "evaluation_id": { "type": "string", "minLength": 1 },
    "test_case_id": { "type": "string", "minLength": 1 },
    "metric_code": { "type": "string", "minLength": 1 },
    "metric_version": { "type": "string", "minLength": 1 },
    "score": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100,
      "description": "Integer score in [0, 100]. Baseline is 50 unless the metric's scoring_rubric overrides; deviations require evidence."
    },
    "reasoning": {
      "type": "string",
      "minLength": 1,
      "description": "Concise rationale that explains how the rubric was applied. Must be evidence-driven."
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "description": "Pointers into ExecutionTrace and/or the enriched test case. Anything not citing trace/test_case is invalid evidence.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source", "ref"],
        "properties": {
          "source": {
            "type": "string",
            "enum": [
              "trace.dialog_turns",
              "trace.actual_tool_calls",
              "trace.actual_artifacts",
              "trace.termination",
              "test_case.expected_output.expected_tool_calls",
              "test_case.expected_output.expected_response_traits",
              "test_case.expected_output.forbidden_behaviors",
              "test_case.expected_output.expected_outcomes",
              "test_case.input"
            ]
          },
          "ref": {
            "type": "string",
            "description": "Path/index/identifier inside the source, e.g. 'turn_index=3', 'tool_name=create_refund_ticket', 'forbidden_behaviors[0]'."
          },
          "quote": { "type": "string" }
        }
      }
    },
    "observed_signals": {
      "type": "array",
      "description": "Deterministic signals the LLM is allowed to RAISE for the deterministic STEP 7 redLineCheck to consume. The LLM MUST NOT itself decide pass/fail.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["signal"],
        "properties": {
          "signal": {
            "type": "string",
            "enum": [
              "missing_required_tool_call",
              "wrong_tool_arguments",
              "forbidden_behavior_triggered",
              "expected_outcome_not_produced",
              "interaction_quality_floor_at_risk",
              "process_compliance_floor_at_risk"
            ]
          },
          "detail": { "type": "string" },
          "evidence_index": {
            "type": "integer",
            "minimum": 0,
            "description": "Index into the evidence[] array above."
          }
        }
      }
    },
    "rubric_adjustments": {
      "type": "array",
      "description": "Itemized score adjustments mapped to scoring_rubric.dimensions in the metric file. Sum of adjustments must explain (score - baseline).",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["rule_id", "delta"],
        "properties": {
          "rule_id": { "type": "string", "minLength": 1 },
          "delta": { "type": "integer" },
          "evidence_index": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    }
  }
}
