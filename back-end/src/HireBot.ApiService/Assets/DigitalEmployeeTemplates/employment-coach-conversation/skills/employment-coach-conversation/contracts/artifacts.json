{
  "schemaVersion": 1,
  "stages": [
    {
      "name": "stage1_material",
      "label": "阶段 1：资料收集",
      "ownerSkill": "employment-coach-conversation",
      "artifacts": [
        {
          "type": "material_collection_progress",
          "label": "资料收集进度",
          "display": "progress",
          "terminal": false
        },
        {
          "type": "material_handoff_summary",
          "label": "资料工单摘要",
          "display": "tree",
          "terminal": true
        }
      ]
    },
    {
      "name": "stage2_skill",
      "label": "阶段 2：技能定义",
      "ownerSkill": "employment-coach-conversation",
      "gate": { "requiresStage": "stage1_material" },
      "artifacts": [
        {
          "type": "skill_workorder_progress",
          "label": "技能工单进度",
          "display": "progress",
          "terminal": false
        },
        {
          "type": "skill_workorder_summary",
          "label": "技能工单摘要",
          "display": "tree",
          "terminal": true
        },
        {
          "type": "skill_generation_ready",
          "label": "等待确认开始生成技能实现",
          "display": "badge",
          "terminal": false,
          "note": "技能定义已确认完成后发送，只驱动技能实现轨为 waiting_confirm，不得回写主 skill 阶段未完成。"
        }
      ]
    },
    {
      "name": "stage3_external",
      "label": "阶段 3：外部能力",
      "ownerSkill": "employment-coach-conversation",
      "gate": { "requiresStage": "stage2_skill" },
      "artifacts": [
        {
          "type": "external_workorder_progress",
          "label": "外部能力工单进度",
          "display": "progress",
          "terminal": false
        },
        {
          "type": "external_workorder_summary",
          "label": "外部能力工单摘要",
          "display": "tree",
          "terminal": true
        }
      ]
    },
    {
      "name": "stage4_packaging",
      "label": "阶段 4：实例打包",
      "ownerSkill": "employment-coach-conversation",
      "gate": { "requiresStage": "stage3_external" },
      "artifacts": [
        {
          "type": "packaging_progress",
          "label": "正在打包工作区",
          "display": "progress",
          "terminal": false
        },
        {
          "type": "template_package",
          "label": "实例包已就绪",
          "kind": "file",
          "display": "file",
          "terminal": true,
          "note": "kind 必须为 file，fileUrl 指向沙箱网关的产物下载地址，触发前端 auto-importPackage"
        }
      ]
    }
  ],

  "packaging_stage": {
    "name": "stage4_packaging",
    "label": "阶段 4：实例打包",
    "ownerSkill": "employment-coach-conversation",
    "gate": {
      "anyOf": [
        {
          "kind": "downstream_terminal",
          "requiresDownstream": [
            "ontology-extraction",
            "skill-generation",
            "external-config"
          ]
        },
        {
          "kind": "user_explicit_request",
          "requiresCoachSummaries": [
            "material_handoff_summary",
            "skill_workorder_summary",
            "external_workorder_summary"
          ],
          "userIntentKeywords": ["生成产物包", "打包", "生成实例包", "导出", "打成 zip", "完成打包"]
        }
      ]
    },
    "description": "进入条件二选一：(A) 下游三个 skill 全部发出 terminal artifact；(B) 本 coach 三个阶段 summary 已发出且用户在对话中显式请求打包。任一成立后先进入阶段 4：若下游已齐，调用 package_workspace 工具真实打包并推送 template_package；若下游未齐，只允许推送 packaging_progress(status=waiting_downstream) 说明仍在等待的下游项，等缺失项补齐后再真实打包。严禁未真实调用打包工具就宣称已打包。",
    "artifacts": [
      {
        "type": "packaging_progress",
        "label": "正在打包工作区",
        "display": "progress",
        "terminal": false
      },
      {
        "type": "template_package",
        "label": "实例包已就绪",
        "kind": "file",
        "display": "file",
        "terminal": true,
        "note": "kind 必须为 file，fileUrl 指向沙箱网关的产物下载地址，触发前端 auto-importPackage"
      }
    ]
  },

  "downstream_artifacts": {
    "description": "下游三个 skill 各自发出的 artifact，以及由上游 coach 发出的技能实现确认状态。前端应将这些 artifact 路由到独立的下游执行轨，不得覆盖主流程 stage 的 completed 语义。",
    "artifacts": [
      {
        "type": "skill_generation_ready",
        "ownerSkill": "employment-coach-conversation",
        "label": "等待确认开始生成技能实现",
        "display": "badge",
        "terminal": false
      },
      {
        "type": "ontology_extraction_progress",
        "ownerSkill": "ontology-extraction",
        "label": "本体抽取进度",
        "display": "progress",
        "terminal": false
      },
      {
        "type": "ontology_extraction_done",
        "ownerSkill": "ontology-extraction",
        "label": "本体抽取完成",
        "display": "tree",
        "terminal": true
      },
      {
        "type": "skill_generation_progress",
        "ownerSkill": "skill-generation",
        "label": "技能包生成进度",
        "display": "progress",
        "terminal": false
      },
      {
        "type": "skill_generation_done",
        "ownerSkill": "skill-generation",
        "label": "技能包生成完成",
        "display": "tree",
        "terminal": true
      },
      {
        "type": "external_config_progress",
        "ownerSkill": "external-config",
        "label": "外部配置生成进度",
        "display": "progress",
        "terminal": false
      },
      {
        "type": "external_config_done",
        "ownerSkill": "external-config",
        "label": "外部配置生成完成",
        "display": "tree",
        "terminal": true
      }
    ]
  }
}
