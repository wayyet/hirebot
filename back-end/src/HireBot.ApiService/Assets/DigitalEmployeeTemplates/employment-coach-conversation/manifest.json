{
  "name": "employment-coach-conversation",
  "display_name": "雇佣教练对话包",
  "positioning": "数字员工雇佣流程的 AI 对话导航中枢，通过「资料 → 技能 → 外部」三阶段引导把业务需求转化为可部署的工单集",
  "description": "以雇佣教练身份引导业务用户完成「资料 → 技能 → 外部」三阶段对话装配。通过 Handoff 工单驱动 ontology-extraction、skill-generation、external-config 三个下游 skill，每阶段在满足明确度门槛后发出 dispatch 信号，等待回传确认后解锁下一阶段，最终产出可被实例打包使用的完整工单集。",
  "version": "v1.0.0",
  "entry_skill": "skills/employment-coach-conversation",
  "ontology_slices": [
    {
      "name": "hiring-discovery-ontology",
      "path": "ontology/ontology-slice.md",
      "type": "digital_employee_slice",
      "required": true
    }
  ],
  "skills": [
    {
      "name": "employment-coach-conversation",
      "path": "skills/employment-coach-conversation/SKILL.md",
      "required": true
    },
    {
      "name": "ontology-extraction",
      "path": "skills/ontology-extraction/SKILL.md",
      "required": true
    },
    {
      "name": "skill-generation",
      "path": "skills/skill-generation/SKILL.md",
      "required": true
    },
    {
      "name": "external-config",
      "path": "skills/external-config/SKILL.md",
      "required": true
    }
  ],
  "stage_rules": [
    {
      "stage": "material",
      "skill_name": "employment-coach-conversation",
      "description": "引导用户归类业务资料并写清抽取目标，生成可交给 ontology-extraction 的 Handoff 工单；至少 1 份资料完成分类且标注抽取目标后可 dispatch",
      "required_fields": ["source_files", "category", "objective"]
    },
    {
      "stage": "skill",
      "skill_name": "employment-coach-conversation",
      "description": "确认模板基线技能并为本轮新增技能写清 name + description + trigger + expected_output，生成包含 reuse_existing 和 generate_new 的技能工单",
      "required_fields": ["skill_name", "skill_description", "trigger", "expected_output", "generation_action"]
    },
    {
      "stage": "external",
      "skill_name": "employment-coach-conversation",
      "description": "收集外部系统对接需求，明确 category、target_system、objective 和关联 skill，生成可交给 external-config 的外部能力工单",
      "required_fields": ["category", "target_system", "objective", "linked_skills"]
    }
  ]
}
