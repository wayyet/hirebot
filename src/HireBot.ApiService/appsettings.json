{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=HireBot;Username=postgres;Password=postgres;"
  },
  "Database": {
    "AutoMigrateOnStartup": false
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "HireBot": {
    "EvaluationResourceRoot": "wwwroot/resources",
    "SystemSkillsRoot": "Assets/SystemSkills",
    "TemplatePackagesRoot": "Assets/TemplatePackages",
    "ConversationKickoffPrompt": "你是雇佣流程助手。请根据当前阶段提出第一个关键问题，引导用户完善模板包内容。"
  },
  "KingCrew": {
    "BaseUrl": "http://localhost:18789/",
    "EnableLocalSimulation": false,
    "BearerToken": "",
    "HttpTimeoutSeconds": 120,
    "HireBotApiPrefix": "/api/integration/hirebot"
  },
  "KingCrab": {
    "BaseUrl": "http://localhost:18789/",
    "BearerToken": "",
    "HttpTimeoutSeconds": 120,
    "HireBotApiPrefix": "/api/integration/hirebot"
  },
  "AllowedOrigins": [
    "http://localhost:5173",
    "http://localhost:3000"
  ],
  "OpenSandbox": {
    "Domain": "opensandbox-server.zyagi.cn:1080",
    "Protocol": "Http",
    "UseServerProxy": true,
    "Image": "ai4c-tcr.tencentcloudcr.com/agentfoundry/king-crab:opensandbox-202604211210",
    "Resource": {
      "cpu": "1000m",
      "memory": "2Gi"
    },
    "TimeoutSeconds": 43200,
    "ReadyTimeoutSeconds": 180,
    "GatewayPort": 18789,
    "Entrypoint": [ "/app/OpenClaw.Gateway" ],
    "KingCrab": {
      "AuthToken": "king-crab-sandbox-token",
      "OidcAuthority": "",
      "OidcAudience": "account",
      "ToolTimeoutSeconds": 300,
      "LlmModel": "",
      "LlmEndpoint": "",
      "LlmApiKey": "",
      "NetworkEgressAllowHosts": []
    }
  },
  "SandboxPvc": {
    "Enabled": false,
    "Namespace": "opensandbox",
    "StorageClassName": "",
    "WorkspaceSize": "5Gi",
    "MemorySize": "5Gi",
    "AccessMode": "ReadWriteMany",
    "KubeConfigPath": ""
  },
  "BuildService": {
    "BaseUrl": "http://test-ncrew-builder.zyagi.cn:1080/",
    "ApiPrefix": "/api/store",
    "BearerToken": "",
    "HttpTimeoutSeconds": 60
  },
  "Security": {
    "OidcAuthority": "",
    "OidcAudience": "",
    "OidcRequireHttpsMetadata": true
  },
  "AllowedHosts": "*"
